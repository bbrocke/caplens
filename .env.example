# Supabase project URL and public anon key (safe for client-side use).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. Server-side only — used by the sync/validate
# scripts in scripts/. Never expose this to the client.
SUPABASE_SECRET_KEY=

# Optional. NHL season for scripts/sync-rosters.ts, format YYYYYYYY.
# Defaults to 20252026 if unset.
NHL_SEASON=
